{
    "name": "gulu-university/gu-aia",
    "description": "Gulu University AI Assistant - a retrieval assistant for gu.ac.ug, answering only from published University content, with a citation on every answer.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "GuAia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GuAia\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:invariant": "phpunit --testsuite invariant",
        "eval": "php bin/evaluate.php",
        "analyse": "phpstan analyse",
        "lint": "phpcs",
        "check:no-delete": "! grep -rniE '\\b(DELETE[[:space:]]+FROM|->delete\\()' src bin public",
        "eval:seed": "php bin/seed_eval_questions.php",
        "grants:verify": "php bin/verify_grants.php",
        "migrate": "php bin/migrate.php",
        "ci": [
            "@analyse",
            "@lint",
            "@test",
            "@eval"
        ]
    }
}
