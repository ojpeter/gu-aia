# Copy this file to .env and fill in real values. Never commit .env itself.
# CLAUDE.md Rule 3: secrets never enter the repository, and are rotated on a
# stated schedule (requirements.md Section 11).

APP_ENV=development
APP_NAME="Gulu University AI Assistant"
APP_BASE_URL=http://localhost/gu-aia/

# --- Database (requirements.md Section 3: MySQL 8, schema gu_aia) -------------
DB_HOST=localhost
DB_NAME=gu_aia
DB_CHARSET=utf8mb4

# One account per role, least privilege, each verified functionally rather than
# asserted from the GRANT statement (CLAUDE.md Rule 3).
#
#   DB_APP_*        web-serving: SELECT on corpus tables, INSERT on log tables.
#                   No DDL. No DELETE (INV-12).
#   DB_INGEST_*     ingestion worker: write access to corpus tables only.
#   DB_MIGRATION_*  the only account with DDL rights. Used by bin/migrate.php
#                   and nowhere else.
DB_APP_USER=gu_aia_app
DB_APP_PASS=
DB_INGEST_USER=gu_aia_ingest
DB_INGEST_PASS=
DB_MIGRATION_USER=gu_aia_migrate
DB_MIGRATION_PASS=

# --- Generation (requirements.md Section 18, open question 1) -----------------
# Kept behind the Generator interface so the hosted-vs-self-hosted decision stays
# reversible. Use "fake" for tests and local work — the whole system must be
# demonstrable with no API key and no spend (CLAUDE.md Rule 10).
GENERATOR_DRIVER=fake
GENERATOR_API_KEY=
GENERATOR_MODEL=
GENERATOR_TIMEOUT_SECONDS=8

# --- Budget (INV-8) -----------------------------------------------------------
# Monthly ceiling set by the Chief, ICT Services before launch (open question 4).
# At 80% alert; at 100% degrade to retrieval-only. Never overspend, never fail
# silently.
BUDGET_MONTHLY_CEILING=
BUDGET_ALERT_THRESHOLD=0.8
BUDGET_ALERT_EMAIL=

# --- Retention (INV-12, DPPA 2019) -------------------------------------------
# Set with the University's data protection function (open question 5) and
# published in the privacy notice. Expiry redacts; it never deletes.
LOG_RETENTION_DAYS=
TECHNICAL_LOG_RETENTION_DAYS=

# --- Log pseudonymisation (docs/data-protection.md DF-2) --------------------
# HMAC key for hashing IP addresses and session identifiers before they are
# stored. REQUIRED: the code refuses to fall back to an unkeyed hash, because a
# plain SHA-256 of an IPv4 address is reversible in minutes and would produce a
# column that looks pseudonymised, passes review, and is not.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
LOG_HASH_KEY=

# --- Embedded widget host ----------------------------------------------------
# The public site the widget is embedded in. Used for CSP frame-ancestors and
# CORS, so the embedded case is configured rather than assumed.
WIDGET_ALLOWED_ORIGIN=http://localhost/gu-website

SESSION_COOKIE_NAME=gu_aia_session
